# Copy to .env and adjust. Every value has a working default.

# Host port the configurator listens on.
CONFIGURATOR_PORT=8090

# The photo folder to manage. Must be the same folder (or share) the gallery
# serves — relative paths are resolved from this configurator/ directory.
PHOTOS_PATH=../photos

# The gallery's thumbnail folder, mounted read-only so photo grids reuse the
# thumbnails it already rendered. Same value as the gallery's THUMBS_PATH.
# Leave it pointing anywhere that does not exist to fall back to generating.
THUMBS_PATH=../thumbnails

# Where the thumbnail fallback cache and the backups of overwritten files go.
DATA_PATH=./data

# Fallback preview size, for photos the gallery has not thumbnailed yet.
THUMB_SIZE=320

# Versions kept per edited file under DATA_PATH/backups.
BACKUPS=20

# Cap on icon/font uploads, in MB.
MAX_UPLOAD_MB=8

# 1 = browse and validate only, no writes at all.
READ_ONLY=0
