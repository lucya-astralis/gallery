# Copy this file to `.env` and adjust. Every value has a working default.

# ----- where things live ------------------------------------------------
# Your images. Each subfolder = album. Example for an SMB mount on Linux:
# /mnt/vega-gallery
PHOTOS_PATH=./photos

# Generated files and the SQLite index (can stay local, no need for SMB)
THUMBS_PATH=./thumbnails
PREVIEWS_PATH=./previews
DATA_PATH=./data

# Who the container runs as. Must own the four paths above — including the
# photo share, where the console writes album.cfg and friends. A CIFS mount
# has no real owners: give it uid=/gid= matching these numbers in fstab.
# Upgrading from a pre-1.0 container that ran as root:
#   sudo chown -R 10001:10001 data thumbnails previews
APERTURE_UID=10001
APERTURE_GID=10001

# ----- what this instance is -------------------------------------------
# all     one container, gallery and console        (default)
# public  the exposed instance — mount photos :ro
# console the operator instance, internal only
APERTURE_ROLE=all

# ----- the gallery ------------------------------------------------------
PORT=8000

# Max edge of the grid thumbnails / of the stage previews, in pixels
THUMB_SIZE=480
PREVIEW_SIZE=1600

# Periodic rescan in seconds (0 = off). Recommended on SMB/CIFS/NFS, where
# inotify does not fire. 300 = every 5 minutes.
SCAN_INTERVAL=300

# File watcher (1/0). On SMB it adds little, locally it adds a lot.
ENABLE_WATCHER=0

# Strip GPS coordinates from what is shown and served (1/0). Default 1.
HIDE_GPS=1
STRIP_GPS=1

# Set when behind a reverse proxy that terminates TLS, for link previews.
# PUBLIC_BASE_URL=https://gallery.lucya.systems

# The reverse proxy in front of Aperture, if any: its address or network,
# comma-separated. Only these peers are believed when they say who the client
# is. The console's login throttle and audit log key on that address, so with
# the proxy left untrusted every visitor looks like the proxy.
# Never `*` if the ports are reachable without going through the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# ----- the console ------------------------------------------------------
# The operator surface. It has the only write path into the photo tree, so
# where it is reachable from is a security decision, not a convenience one.

CONSOLE_ENABLED=1
CONSOLE_PORT=8090

# The console asks for a password. Set one before first start:
#   docker compose run --rm aperture python -m aperture.cli passwd
#   python -m aperture.cli passwd            # without Docker
#
# Without a password Aperture refuses to open the console's socket, because
# inside a container it must bind 0.0.0.0 and cannot tell that you only
# published the port on loopback. If that is your setup and you want it open
# anyway, say so — it means anything that reaches the port can rewrite this
# gallery's configuration:
CONSOLE_ALLOW_OPEN=0

# WHICH HOST ADDRESS the console's port is published on. This is the boundary.
#   127.0.0.1   this machine only (default) — reach it over SSH or a VPN
#   10.0.0.5    exactly that interface, e.g. a LAN or WireGuard address
#   0.0.0.0     every interface — only with a password set, and Aperture
#               refuses to start otherwise
CONSOLE_HOST=127.0.0.1

# 1 = browse and validate without being able to write anything.
READ_ONLY=0

# Versions kept per edited file under DATA_PATH/console/backups.
BACKUPS=20

# Cap on icon/font/wallpaper uploads, in MB.
MAX_UPLOAD_MB=8
